{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "chenyubang/examples",
  "title": "真题表（题库包 examples.json）",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "stem", "options", "answer", "explain", "examType", "year", "questionType", "idiomIds"],
    "properties": {
      "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
      "stem": { "type": "string", "pattern": ".{6,}" },
      "options": {
        "type": "object",
        "additionalProperties": false,
        "required": ["A", "B", "C", "D"],
        "properties": {
          "A": { "type": "string", "pattern": ".{2,}" },
          "B": { "type": "string", "pattern": ".{2,}" },
          "C": { "type": "string", "pattern": ".{2,}" },
          "D": { "type": "string", "pattern": ".{2,}" }
        }
      },
      "answer": { "type": "string", "enum": ["A", "B", "C", "D"] },
      "explain": { "type": "string", "pattern": ".{4,}" },
      "examType": { "type": "string", "enum": ["国考", "省考", "事业编", "教师编"] },
      "year": { "type": "integer", "minimum": 2000, "maximum": 2100 },
      "region": { "type": "string", "pattern": ".{2,}" },
      "questionType": { "type": "string", "enum": ["言语理解", "逻辑填空", "语句表达", "常识判断"] },
      "idiomIds": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
      }
    }
  }
}
