{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "chenyubang/idioms",
  "title": "成语表（题库包 idioms.json）",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "word", "pinyin", "initials", "sense", "color", "frequency", "scopes"],
    "properties": {
      "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
      "word": { "type": "string", "pattern": "^[\\u4e00-\\u9fa5]{2,8}$" },
      "pinyin": { "type": "string", "pattern": "^[a-z]+( [a-z]+){1,7}$" },
      "initials": { "type": "string", "pattern": "^[a-z]{2,8}$" },
      "sense": { "type": "string", "pattern": ".{4,}" },
      "origin": { "type": "string", "pattern": ".{4,}" },
      "color": { "type": "string", "enum": ["褒义", "贬义", "中性"] },
      "pitfalls": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "note"],
          "properties": {
            "kind": { "type": "string", "enum": ["望文生义", "对象误用", "褒贬误用", "语义重复", "搭配不当"] },
            "note": { "type": "string", "pattern": ".{4,}" }
          }
        }
      },
      "synonyms": { "type": "array", "items": { "type": "string", "pattern": "^[\\u4e00-\\u9fa5]{2,8}$" } },
      "antonyms": { "type": "array", "items": { "type": "string", "pattern": "^[\\u4e00-\\u9fa5]{2,8}$" } },
      "frequency": { "type": "integer", "minimum": 1, "maximum": 5 },
      "scopes": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "enum": ["国考", "省考", "事业编", "教师编"] }
      }
    }
  }
}
